{
  "name": "max-green-api-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsup server/index.ts --format esm --out-dir dist/server",
    "start": "node dist/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "vitest run",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "hono": "^4.12.23",
    "zod": "^3.25.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vite": "^8.0.16",
    "@vitejs/plugin-react": "^6.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "vitest": "^3.2.7",
    "jsdom": "^30.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@playwright/test": "^1.59.1"
  }
}
